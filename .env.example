# ============================================
# PostgreSQL Database Configuration
# ============================================
# You can use either DATABASE_URL (full connection string) or individual components below

# Option 1: Full connection string (recommended)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kadena_nexus

# Option 2: Individual database components (used if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=kadena_nexus

# ============================================
# Server Configuration
# ============================================
# Profile API Server Port
PORT=3001

# ============================================
# Frontend Environment Variables (Vite)
# These must be prefixed with VITE_ to be accessible in the browser
# ============================================

# Chainweb API. chainweb.chaddex.com is active (api.chainweb.com not valid at the moment).
VITE_CHAINWEB_PROXY_TARGET=https://chainweb.chaddex.com
VITE_CHAINWEB_API=https://chainweb.chaddex.com/chainweb/0.0/mainnet01/chain/1/pact

VITE_CONTRACT_NAMESPACE=free
VITE_CONTRACT_MODULE=p2p-escrow6
# Profile API Server URL (optional)
# - Development: set to your backend URL, e.g. http://localhost:3001 (Vite will proxy /api to it if unset).
# - Production: leave unset or empty so the app uses the same domain (e.g. https://yoursite.com/api/...).
#   Ensure your backend is running and Nginx (or your host) proxies /api to the backend.
# Default in dev when unset: Vite proxy uses http://127.0.0.1:3001
VITE_PROFILE_API=http://localhost:3001
