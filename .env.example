# ============================================
# PostgreSQL Database Configuration
# ============================================
# You can use either DATABASE_URL (full connection string) or individual components below

# Option 1: Full connection string (recommended)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kadena_nexus

# Option 2: Individual database components (used if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=kadena_nexus

# ============================================
# Server Configuration
# ============================================
# Profile API Server Port
PORT=3001

# ============================================
# Frontend Environment Variables (Vite)
# These must be prefixed with VITE_ to be accessible in the browser
# ============================================

# Chainweb Proxy Target
# The Chainweb API endpoint to proxy requests to
# Default: https://chainweb.chaddex.com
# Example alternatives:
#   - https://us-e1.chainweb.com (Kadena official)
#   - https://chainweb.chaddex.com (Chaddex)
VITE_CHAINWEB_PROXY_TARGET=https://chainweb.chaddex.com

# Profile API Server URL
# The URL where the profile API server is running
# Default: http://localhost:3001
# In production, set this to your deployed API server URL
VITE_PROFILE_API=http://localhost:3001
